rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read and write their own documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Modules can only be read/written by the module owner
    match /modules/{moduleId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && request.resource.data.userId == request.auth.uid && resource.data.userId == request.auth.uid;
    }

    // Chats inside modules
    match /modules/{moduleId}/chats/{chatId} {
      allow read, write: if request.auth != null && get(/databases/$(database)/documents/modules/$(moduleId)).data.userId == request.auth.uid;
    }

    // Flashcards
    match /flashcards/{cardId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && request.resource.data.userId == request.auth.uid && resource.data.userId == request.auth.uid;
    }
  }
}
